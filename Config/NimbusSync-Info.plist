<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleDisplayName</key>
    <string>$(NIMBUSSYNC_DISPLAY_NAME)</string>
    <key>CFBundleName</key>
    <string>$(NIMBUSSYNC_DISPLAY_NAME)</string>
    <key>NimbusSyncBundleIdentifierBase</key>
    <string>$(NIMBUSSYNC_BUNDLE_ID_BASE)</string>
    <key>NimbusSyncAppGroupIdentifier</key>
    <string>$(APP_GROUP_IDENTIFIER)</string>
    <key>NimbusSyncURLScheme</key>
    <string>$(NIMBUSSYNC_URL_SCHEME)</string>
    <key>NimbusSyncDisplayName</key>
    <string>$(NIMBUSSYNC_DISPLAY_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NimbusSyncVersion</key>
    <string>$(NIMBUSSYNC_VERSION)</string>
    <key>NimbusSyncUpdatesEnabled</key>
    <string>$(NIMBUSSYNC_UPDATES_ENABLED)</string>
    <!-- Sparkle (see Apps/NimbusSync/AppUpdater.swift and docs/releasing.md). The feed lists the
         stable channel plus `beta` items; prereleases reach only users who opt in to betas. -->
    <key>SUFeedURL</key>
    <string>https://jorben.github.io/NimbusSync/appcast.xml</string>
    <!-- EdDSA public key from Sparkle's generate_keys; the private key is the SPARKLE_PRIVATE_KEY
         repository secret. publish-appcast.yml refuses a private key that does not match. -->
    <key>SUPublicEDKey</key>
    <string>TIYT44jkUyXMQZfqUK0CBM7KYsBuIt/JENuHGz06ZEE=</string>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
    <!-- Sandboxed app: Sparkle's installer runs through its launcher XPC service. Downloads stay
         in-process (the app has the network client entitlement). -->
    <key>SUEnableInstallerLauncherService</key>
    <true/>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUAllowsAutomaticUpdates</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>LSUIElement</key>
    <true/>
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLName</key>
            <string>$(NIMBUSSYNC_BUNDLE_ID_BASE)</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>cloudreve</string>
                <string>$(NIMBUSSYNC_URL_SCHEME)</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
