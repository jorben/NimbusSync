# NimbusSync machine-local build configuration template.
# Copy to Config/build.local.sh. The copied file is ignored by Git.
# Command-line environment variables take precedence over these values.

# Unsigned Debug is the portable default.
NIMBUSSYNC_CONFIGURATION="${NIMBUSSYNC_CONFIGURATION:-Debug}"
NIMBUSSYNC_SIGNING_MODE="${NIMBUSSYNC_SIGNING_MODE:-unsigned}"
# Bundle IDs, App Group and Keychain group come from Config/<Configuration>.xcconfig:
# Debug builds the coexisting "NimbusSyncDev" (io.github.jorben.nimbussync.dev),
# Release the shipping app (io.github.jorben.nimbussync).

# Optional local manual signing settings. Fill these only when signed builds
# are required, using profiles and a certificate installed on this Mac.
# NIMBUSSYNC_CONFIGURATION="${NIMBUSSYNC_CONFIGURATION:-Release}"
# NIMBUSSYNC_SIGNING_MODE="${NIMBUSSYNC_SIGNING_MODE:-signed}"
# NIMBUSSYNC_DEVELOPMENT_TEAM="YOUR_TEAM_ID"
# NIMBUSSYNC_CODE_SIGN_IDENTITY="Developer ID Application: Your Name (YOUR_TEAM_ID)"
# NIMBUSSYNC_APP_PROFILE="APP_PROFILE_UUID"
# NIMBUSSYNC_FILE_PROVIDER_PROFILE="FILE_PROVIDER_PROFILE_UUID"
# NIMBUSSYNC_FILE_PROVIDER_UI_PROFILE="FILE_PROVIDER_UI_PROFILE_UUID"
#
# Debug and Release are different App IDs, so each needs its own profiles. A
# NIMBUSSYNC_DEBUG_* / NIMBUSSYNC_RELEASE_* value wins over the generic one for
# that configuration (also for CODE_SIGN_IDENTITY: Debug's File Provider testing
# mode needs an Apple Development identity and development profiles).
# NIMBUSSYNC_DEBUG_CODE_SIGN_IDENTITY="Apple Development: Your Name (XXXXXXXXXX)"
# NIMBUSSYNC_DEBUG_APP_PROFILE="DEV_APP_PROFILE_UUID"
# NIMBUSSYNC_DEBUG_FILE_PROVIDER_PROFILE="DEV_FILE_PROVIDER_PROFILE_UUID"
# NIMBUSSYNC_DEBUG_FILE_PROVIDER_UI_PROFILE="DEV_FILE_PROVIDER_UI_PROFILE_UUID"
# NIMBUSSYNC_RELEASE_APP_PROFILE="APP_PROFILE_UUID"
# NIMBUSSYNC_RELEASE_FILE_PROVIDER_PROFILE="FILE_PROVIDER_PROFILE_UUID"
# NIMBUSSYNC_RELEASE_FILE_PROVIDER_UI_PROFILE="FILE_PROVIDER_UI_PROFILE_UUID"
