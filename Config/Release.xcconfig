// Release identity. Keep these values stable once shipped: the bundle ID, App Group and Keychain
// access group are what tie an installed copy to its data and credentials.
NIMBUSSYNC_BUNDLE_ID_BASE = io.github.jorben.nimbussync
NIMBUSSYNC_DISPLAY_NAME = NimbusSync
NIMBUSSYNC_URL_SCHEME = nimbussync
PRODUCT_BUNDLE_IDENTIFIER = $(NIMBUSSYNC_BUNDLE_ID_BASE)
PRODUCT_NAME = NimbusSync
SWIFT_VERSION = 6.0
MACOSX_DEPLOYMENT_TARGET = 13.0
CODE_SIGN_IDENTITY = Developer ID Application
CODE_SIGNING_REQUIRED = YES
CODE_SIGNING_ALLOWED = YES
APP_GROUP_IDENTIFIER = group.$(NIMBUSSYNC_BUNDLE_ID_BASE)
KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(NIMBUSSYNC_BUNDLE_ID_BASE)
