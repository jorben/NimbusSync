// Release identity. Keep these values stable once shipped: the bundle ID, App Group and Keychain
// access group are what tie an installed copy to its data and credentials.
NIMBUSSYNC_BUNDLE_ID_BASE = io.github.jorben.nimbussync
NIMBUSSYNC_DISPLAY_NAME = NimbusSync
NIMBUSSYNC_URL_SCHEME = nimbussync
PRODUCT_BUNDLE_IDENTIFIER = $(NIMBUSSYNC_BUNDLE_ID_BASE)
// The app bundle and its executable: NimbusSync.app.
NIMBUSSYNC_APP_NAME = NimbusSync
NIMBUSSYNC_APP_ICON_NAME = AppIcon
// The Dev icon is part of the target for Debug only; keep it out of the shipping bundle.
EXCLUDED_SOURCE_FILE_NAMES = AppIconDev.icon
SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = YES
MACOSX_DEPLOYMENT_TARGET = 13.0
// CFBundleShortVersionString. CI overrides it (and the build number) via Scripts/build.sh.
MARKETING_VERSION = 0.1.0
// The full version the app shows (Info.plist NimbusSyncVersion), including a pre-release suffix
// such as 0.1.0-rc.3 that CFBundleShortVersionString cannot carry. Scripts/build.sh sets it from
// VERSION (the release tag in CI).
NIMBUSSYNC_VERSION = $(MARKETING_VERSION)
// In-app updates through Sparkle (Info.plist NimbusSyncUpdatesEnabled). Only the shipping identity
// updates itself; the Dev build would otherwise replace itself with the Release app.
NIMBUSSYNC_UPDATES_ENABLED = YES
CODE_SIGN_IDENTITY = Developer ID Application
CODE_SIGNING_REQUIRED = YES
CODE_SIGNING_ALLOWED = YES
APP_GROUP_IDENTIFIER = group.$(NIMBUSSYNC_BUNDLE_ID_BASE)
KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(NIMBUSSYNC_BUNDLE_ID_BASE)
// xcodebuild build otherwise injects com.apple.security.get-task-allow, which notarization rejects.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
// Notarization requires a secure timestamp; plain xcodebuild build signs with --timestamp=none.
OTHER_CODE_SIGN_FLAGS = $(inherited) --timestamp
