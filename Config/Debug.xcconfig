// Dev identity: everything derived from NIMBUSSYNC_BUNDLE_ID_BASE gets a `.dev` suffix so a Debug
// build can be installed next to the Release app without sharing data, credentials or deep links.
NIMBUSSYNC_BUNDLE_ID_BASE = io.github.jorben.nimbussync.dev
NIMBUSSYNC_DISPLAY_NAME = NimbusSyncDev
NIMBUSSYNC_URL_SCHEME = nimbussync-dev
PRODUCT_BUNDLE_IDENTIFIER = $(NIMBUSSYNC_BUNDLE_ID_BASE)
// The app bundle and its executable: NimbusSyncDev.app, so Finder, Login Items and the File
// Providers list in System Settings (which show the bundle's file name) tell it from the Release app.
NIMBUSSYNC_APP_NAME = NimbusSyncDev
// The Release artwork with a "DEV" badge (Scripts/make-dev-app-icon.swift), so the Dock, Finder and
// System Settings show at a glance which build is which.
NIMBUSSYNC_APP_ICON_NAME = AppIconDev
SWIFT_VERSION = 6.0
MACOSX_DEPLOYMENT_TARGET = 13.0
// CFBundleShortVersionString. CI overrides it (and the build number) via Scripts/build.sh.
MARKETING_VERSION = 0.1.0
// The full version the app shows (Info.plist NimbusSyncVersion), including a pre-release suffix
// such as 0.1.0-rc.3 that CFBundleShortVersionString cannot carry. Scripts/build.sh sets it from
// VERSION (the release tag in CI).
NIMBUSSYNC_VERSION = $(MARKETING_VERSION)
// The Dev build never updates itself: the feed only carries the Release app.
NIMBUSSYNC_UPDATES_ENABLED = NO
CODE_SIGN_IDENTITY = -
CODE_SIGNING_REQUIRED = NO
CODE_SIGNING_ALLOWED = NO
DEVELOPMENT_TEAM =
APP_GROUP_IDENTIFIER = group.$(NIMBUSSYNC_BUNDLE_ID_BASE)
KEYCHAIN_ACCESS_GROUP = $(AppIdentifierPrefix)$(NIMBUSSYNC_BUNDLE_ID_BASE)
