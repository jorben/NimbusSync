<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleDisplayName</key>
    <string>$(NIMBUSSYNC_DISPLAY_NAME) File Provider UI</string>
    <key>CFBundleName</key>
    <string>NimbusSyncFileProviderUI</string>
    <key>NimbusSyncBundleIdentifierBase</key>
    <string>$(NIMBUSSYNC_BUNDLE_ID_BASE)</string>
    <key>NimbusSyncAppGroupIdentifier</key>
    <string>$(APP_GROUP_IDENTIFIER)</string>
    <key>NimbusSyncURLScheme</key>
    <string>$(NIMBUSSYNC_URL_SCHEME)</string>
    <key>NimbusSyncDisplayName</key>
    <string>$(NIMBUSSYNC_DISPLAY_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.fileprovider-actionsui</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).ActionViewController</string>
        <key>NSExtensionFileProviderActions</key>
        <array>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>io.github.jorben.nimbussync.open-in-nimbussync</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>finder.action.en.open-in-nimbussync</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.authenticated == TRUE AND ($fileproviderItem.userInfo.nimbussyncLanguage == 'en' OR $fileproviderItem.userInfo.nimbussyncLanguage == nil) ).@count &gt; 0</string>
            </dict>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>io.github.jorben.nimbussync.open-in-nimbussync.zh-Hans</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>finder.action.zh-Hans.open-in-nimbussync</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.authenticated == TRUE AND $fileproviderItem.userInfo.nimbussyncLanguage == 'zh-Hans' ).@count &gt; 0</string>
            </dict>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>io.github.jorben.nimbussync.resolve-conflict</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>finder.action.en.resolve-conflict</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.hasConflict == TRUE AND ($fileproviderItem.userInfo.nimbussyncLanguage == 'en' OR $fileproviderItem.userInfo.nimbussyncLanguage == nil) ).@count &gt; 0</string>
            </dict>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>io.github.jorben.nimbussync.resolve-conflict.zh-Hans</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>finder.action.zh-Hans.resolve-conflict</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.hasConflict == TRUE AND $fileproviderItem.userInfo.nimbussyncLanguage == 'zh-Hans' ).@count &gt; 0</string>
            </dict>
        </array>
    </dict>
</dict>
</plist>
